{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuadratLab",
  "version": "0.1.5",
  "identifier": "com.quadratlab.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "样方实验",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "template": "windows/main.wxs",
        "upgradeCode": "e5ec071b-5c49-5922-a777-133cadd56a48"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "startMenuFolder": "QuadratLab",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
